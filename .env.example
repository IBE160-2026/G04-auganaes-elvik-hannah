# Miljøvariabler for backend (AD-15). Ingen hemmeligheter her.
# Standardverdiene i backend/app/config.py matcher docker-compose.yml, så lokal kjøring
# trenger ingen .env. Vil du overstyre noe: kopier til .env og kjør backend-kommandoene med
# `uv run --env-file ../.env ...` fra backend/.

# PostgreSQL fra docker-compose.yml (vertsport 5433, bruker/passord/database husly).
# postgres:// og postgresql:// gjøres om til postgresql+psycopg:// automatisk.
# I nettversjonen setter Vercels Neon-integrasjon denne (poolet tilkobling).
DATABASE_URL=postgresql+psycopg://husly:husly@localhost:5433/husly

# Valgfri. Direkte (upoolet) tilkobling som bare migreringene bruker. Er den tom, brukes
# DATABASE_URL. Settes av Neon-integrasjonen i nettversjonen; trengs ikke lokalt.
DATABASE_URL_UNPOOLED=
