# Miljøvariabler for backend (AD-15). Ingen hemmeligheter her.
# Standardverdiene i backend/app/config.py matcher docker-compose.yml, så lokal kjøring
# trenger ingen .env. Vil du overstyre noe: kopier til .env og kjør backend-kommandoene med
# `uv run --env-file ../.env ...` fra backend/.

# PostgreSQL fra docker-compose.yml (vertsport 5433, bruker/passord/database husly).
# postgres:// og postgresql:// gjøres om til postgresql+psycopg:// automatisk.
# I nettversjonen setter Vercels Neon-integrasjon denne (poolet tilkobling).
DATABASE_URL=postgresql+psycopg://husly:husly@localhost:5433/husly

# Valgfri. Direkte (upoolet) tilkobling som bare migreringene bruker. Er den tom, brukes
# DATABASE_URL. Settes av Neon-integrasjonen i nettversjonen; trengs ikke lokalt.
DATABASE_URL_UNPOOLED=

# Story 1.2: nøkkelen som signerer innloggingstokenene (JWT, HS256). Minst 32 byte.
# Lokalt kan den stå tom: da brukes en fast utviklingsnøkkel og backenden logger en advarsel.
# På Vercel er den påkrevd (Production og Preview), ellers starter ikke API-et.
# Lag en med: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# (på Windows: python i stedet for python3)
JWT_SECRET=

# Story 1.2: sett til true for å gi refresh-cookien Secure-flagget lokalt (bare over HTTPS).
# Tom eller false lokalt, slik at Safari beholder cookien på http://localhost. På Vercel er
# den alltid Secure, uansett hva som står her.
AUTH_COOKIE_SECURE=

# VERCEL står ikke her med vilje: plattformen setter den selv i nettversjonen. Backenden
# bruker den til å kreve DATABASE_URL og JWT_SECRET, og seed-kommandoen nekter å kjøre da.
